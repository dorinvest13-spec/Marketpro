name: Pages

on:
  push:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Assemble site
        run: |
          set -e
          if [ ! -f index.html ]; then
            echo "::error::В корне репозитория нет index.html"
            exit 1
          fi
          mkdir -p _site/app
          SRC=""
          if [ -d docs ]; then SRC=docs; elif [ -d doc ]; then SRC=doc; fi
          if [ -n "$SRC" ]; then cp -r "$SRC"/. _site/; fi
          cp index.html _site/app/index.html
          if [ ! -f _site/index.html ]; then cp index.html _site/index.html; fi
          if [ ! -f _site/404.html ]; then cp _site/index.html _site/404.html; fi
          touch _site/.nojekyll
          echo "--- состав сайта ---"
          find _site -maxdepth 2 -type f | sort

      - uses: actions/configure-pages@v5

      - uses: actions/upload-pages-artifact@v3
        with:
          path: _site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
